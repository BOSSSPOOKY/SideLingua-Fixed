<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" 
    android:layout_width="wrap_content" 
    android:layout_height="wrap_content">
    <TextView android:id="@+id/bubble_collapsed" 
        android:layout_width="60dp" android:layout_height="100dp"
        android:background="@drawable/bg_bubble" 
        android:text="TR" 
        android:gravity="center"
        android:textColor="#fff" 
        android:textStyle="bold" 
        android:textSize="20sp"
        android:elevation="8dp"/>
    <LinearLayout android:id="@+id/panel_expanded" 
        android:orientation="vertical"
        android:layout_width="340dp" android:layout_height="520dp"
        android:background="@drawable/bg_panel" 
        android:visibility="gone"
        android:padding="16dp" android:elevation="12dp">
        <TextView android:text="SideLingua - Human Translator" android:textStyle="bold" android:textSize="16sp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <RadioGroup android:id="@+id/chip_context" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
            <RadioButton android:id="@+id/chip_assignment" android:text="Assignment" android:checked="true" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <RadioButton android:id="@+id/chip_conversation" android:text="Chat" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <RadioButton android:id="@+id/chip_task" android:text="General" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </RadioGroup>
        <EditText android:id="@+id/input_text" android:hint="Type, paste, or speak... I understand context"
            android:layout_width="match_parent" android:layout_height="110dp" android:background="@android:drawable/edit_text" android:padding="10dp" android:layout_marginTop="8dp" android:gravity="top"/>
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
            <Button android:id="@+id/btn_translate" android:text="Translate Like Human" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        </LinearLayout>
        <TextView android:id="@+id/output_text" android:text="Translation appears here with intent explained..." android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:padding="10dp" android:background="#f5f5f5" android:layout_marginTop="8dp"/>
        <Button android:id="@+id/btn_minimize" android:text="Minimize →" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
    </LinearLayout>
</FrameLayout>
